  "bugs": {
    "url": "https://github.com/Dasariroja/playwright-framework-lab/issues"
  },
  "homepage": "https://github.com/Dasariroja/playwright-framework-lab#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
